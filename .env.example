# PRIMARY PROJECT: file-in-drive-upload / MZ Drive Utilities

# VITE_BACKEND_URL: The URL of the Render.com backend for D-VAC & File In Drive Upload APIs.
# Set this in your Vercel Project Settings > Environment Variables (e.g. https://drive-video-to-audio-converter.onrender.com)
VITE_BACKEND_URL="https://drive-video-to-audio-converter.onrender.com"

# APP_URL: The URL where this frontend is hosted on Vercel
APP_URL="https://your-app.vercel.app"

# PORT: Server listening port (default: 3000, dynamically provided by Render as $PORT)
PORT=3000

# GEMINI_API_KEY: Optional - Required for Gemini AI API calls (if used).
GEMINI_API_KEY=""
